DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/enroute

FRONTEND_URL=http://localhost:3000
PORT=8000
NODE_ENV=development

JWT_SECRET=any-long-random-string-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_HOST=127.0.0.1
EMAIL_PORT=1
EMAIL_SECURE=false
EMAIL_USER=dev
EMAIL_PASSWORD=dev
EMAIL_FROM=dev@localhost

R2_ACCOUNT_ID=dev
R2_ACCESS_KEY_ID=dev
R2_SECRET_ACCESS_KEY=dev
R2_BUCKET_NAME=dev
R2_PUBLIC_URL=http://localhost

# Dev mail sink (pnpm dev:mail): set EMAIL_HOST=127.0.0.1 and EMAIL_PORT to this port. Default 2525.
MAIL_SINK_PORT=2525

# API end-to-end tests (pnpm test:e2e) use their own database, mail sink (2526) and backend (8100).
# Defaults assume local Postgres with your OS user as superuser; override if yours differs.
# E2E_ADMIN_DATABASE_URL=postgres://localhost:5432/postgres
# E2E_DATABASE_URL=postgres://enrouteDb:enroute09832@localhost:5432/enroute_test
