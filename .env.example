# Production environment variables. Copy to .env, fill in, never commit the filled copy.
#
# Plain VPS (docker-compose.yml + docker-compose.vps.yml, see deploy/README.md):
#   the file is /opt/enroute/.env on the server.
# Openship (docker-compose.yml alone):
#   use "Import .env" at PROJECT level (not on one service), and use an api. subdomain below.

# ---- Compose ----
# Fixed project name, so the database volume keeps its name (enroute_postgres_data)
# whatever folder the files sit in.
COMPOSE_PROJECT_NAME=enroute

# ---- Domain (plain VPS only) ----
# Caddy gets the HTTPS certificate for this name and redirects www. to it.
SITE_DOMAIN=enroutelogtek.in

# ---- Database ----
# Both postgres and backend read these. Any characters are OK in the password.
# Generate a strong one with:  openssl rand -hex 24
POSTGRES_DB=enroute
POSTGRES_USER=enroute
POSTGRES_PASSWORD=

# ---- Addresses ----
# The site address (used by the backend for CORS). No trailing slash.
FRONTEND_URL=https://enroutelogtek.in
# The API address the browser calls. It is baked into the frontend when the image is built:
# on the plain VPS, CI/CD reads it from the GitHub repository variable NEXT_PUBLIC_APP_URL,
# so keep the two the same. Plain VPS: same domain, /api/v1.
# Openship: its own subdomain, e.g. https://api.enroutelogtek.in/api/v1
NEXT_PUBLIC_APP_URL=https://enroutelogtek.in/api/v1

# ---- JWT ----
# Long random string.  Generate one with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Email (SMTP) ----
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
