# Production environment variables for docker-compose.yml.
# In Openship: copy this file, fill in the values, and use "Import .env" on the project
# (or add them one by one under Configuration -> Environment variables).
# Never commit the filled-in copy.

# ---- Database ----
# Set these at PROJECT level in Openship (not only on the postgres service):
# both postgres and backend need them. Any characters are OK in the password.
# Generate a strong one with:  openssl rand -hex 24
POSTGRES_DB=enroute
POSTGRES_USER=enroute
POSTGRES_PASSWORD=

# ---- Domains ----
# The site address (used by the backend for CORS). No trailing slash.
FRONTEND_URL=https://enroute.com
# The API address the browser calls (frontend build). Needs its own subdomain.
NEXT_PUBLIC_APP_URL=https://api.enroute.com/api/v1

# ---- JWT ----
# Long random string.  Generate one with:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Email (SMTP) ----
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
